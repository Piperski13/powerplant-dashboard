<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- account, menu icons -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=account_circle,menu,search,filter_list,edit,delete,add"
    />

    <link rel="icon" href="/assets/icons/favicon.png" type="image/svg+xml" />

    <!-- Local Styles -->
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/table.css" />

    <title>Workspace List</title>
  </head>

  <body>
    <div class="app-shell">
      <aside class="app-sidebar">
        <%- include("../partials/sidebar.ejs") %>
      </aside>

      <div class="app-main">
        <main class="app-content records-view-page">
          <nav class="breadcrumbs">
            <a href="/workspaces/Dashboard"> Dashboard </a>

            <span>/</span>

            <span>Workspaces</span>
          </nav>
          <%- include("../partials/_filter-toolbar", {
              searchRoute: "/workspaces/",
              searchParam: "name",
              searchPlaceholder: "Search by Name...",
              searchValue: name,
              createRoute: "/workspaces/new",
              createLabel: "New Workspace",
              user: user,
              ownerId: user ? user.id : null,
              visibility: null,
              usersListPage:false
            }) %>
          <div class="div-tables-section">
            <table id="big-table">
              <caption>
                List of Workspaces
              </caption>
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Collections</th>

                  <% if (user && workspaces.some(workspace => user.id === workspace.owner_id)) { %>
                    <th class="table-actions-header">Actions</th>
                  <% } %>
                </tr>
              </thead>

              <tbody>
                <% if (workspaces && workspaces.length > 0) { %>
                  <% workspaces.forEach(workspace => { %>
                    <tr
                      class="clickable-row"
                      data-href="/workspaces/<%= workspace.id %>"
                    >
                      <td data-label="Name">
                        <div class="table-primary">
                          <%= workspace.name %>
                        </div>
                      </td>

                      <td data-label="Collections">
                        <span class="table-count">
                          <%= workspace.collections_count || 0 %>
                        </span>
                      </td>

                      <% if (user && user.id === workspace.owner_id) { %>
                        <td data-label="Actions" class="table-actions">
                          <div class="table-actions__group">
                            <form
                              action="/workspaces/<%= workspace.id %>/edit"
                              method="GET"
                            >
                              <button
                                type="submit"
                                class="table-action table-action--edit"
                              >
                                <span class="material-symbols-outlined">edit</span>
                                Edit
                              </button>
                            </form>

                            <form
                              action="/workspaces/<%= workspace.id %>/delete"
                              method="POST"
                            >
                              <button
                                type="submit"
                                class="table-action table-action--delete"
                              >
                                <span class="material-symbols-outlined">delete</span>
                                Delete
                              </button>
                            </form>
                          </div>
                        </td>
                      <% } %>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td
                      colspan="<%= user ? 3 : 2 %>"
                      class="table-empty"
                    >
                      No workspaces found.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <div class="back-navigation">
            <a href="/workspaces/dashboard" class="button button--secondary">
              ← Back to Dashboard
            </a>
          </div>
          <%- include("../partials/spinner.ejs") %>
        </main>
      </div>
    </div>
    <script src="/scripts/table-row-navigation.js"></script>
  </body>
</html>
