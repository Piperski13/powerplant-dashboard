<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- account, menu icons -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=account_circle,menu,edit,delete,description"
    />

    <link rel="icon" href="/assets/icons/favicon.png" type="image/svg+xml" />

    <!-- Local Styles -->
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/table.css" />
    <link rel="stylesheet" href="/styles/documents.css">
    <link rel="stylesheet" href="/styles/record.css" />
    

    <title>Record detail</title>
  </head>

  <body>
    <div class="app-shell">
      <aside class="app-sidebar">
        <%- include("../partials/sidebar.ejs") %>
      </aside>

      <div class="app-main">
        <main class="app-content record-details-page">
          <nav class="breadcrumbs">
            <a href="/workspaces/<%= workspace.id %>">
              <%= workspace.name %>
            </a>

            <span>/</span>

            <a
              href="/workspaces/<%= workspace.id %>/collections/<%= collection.id %>"
            >
              <%= collection.name %>
            </a>

            <span>/</span>

            <span> <%= record.title %> </span>
          </nav>
          <h2 class="record-page-title">Record: <%= record.title %></h2>

          <section class="details-card">
            <div class="detail-row">
              <span class="detail-label">Title: </span>

              <span class="detail-value"><%= record.title %></span>
            </div>

            <div class="detail-row">
              <span class="detail-label">Workspace: </span>

              <span class="detail-value"><%= workspace.name %></span>
            </div>

            <div class="detail-row">
              <span class="detail-label">Collection: </span>

              <span class="detail-value"><%= collection.name %></span>
            </div>

            <div class="detail-row">
              <span class="detail-label">Created At: </span>
              <span class="detail-value"><%= formatDate(record.created_at)%></span>
            </div>

            <div data-label="Documents" class="detail-document">
              <% if (record.files && record.files.length > 0) { %>
                <div class="documents-list">
                  <% record.files.forEach(file => { %>
                    <a
                      class="file-link"
                      href="<%= file.downloadUrl %>"
                      download
                      title="<%= file.original_name %>"
                    >
                      <span class="material-symbols-outlined">description</span>
                      <span class="file-link__name">
                        <%= file.original_name %>
                      </span>
                    </a>
                  <% }) %>
                </div>
                <% } else { %>
                  <span class="documents-empty">No files</span>
                <% } %>
                </div>

            <% if (user && user.id === workspace.owner_id) { %>
            <div data-label="Actions" class="table-actions">
              <div class="table-actions__group">
                <form
                  action="/workspaces/<%= workspace.id %>/collections/<%= collection.id %>/records/<%= record.id %>/edit"
                  method="GET"
                >
                  <button
                    type="submit"
                    class="table-action table-action--edit"
                  >
                    <span class="material-symbols-outlined">edit</span>
                    Edit
                  </button>
                </form>

                <form
                  action="/workspaces/<%= workspace.id %>/collections/<%= collection.id %>/records/<%= record.id %>/delete"
                  method="POST"
                >
                  <button
                    type="submit"
                    class="table-action table-action--delete"
                  >
                    <span class="material-symbols-outlined">delete</span>
                    Delete
                  </button>
                </form>
              </div>
            </div>
            <% } %>
          </section>
          <div class="back-navigation">
            <a
              href="/workspaces/<%= workspace.id %>/collections/<%= collection.id %>"
              class="button button--secondary"
            >
              ← Back to Collection
            </a>
          </div>
          <%- include("../partials/spinner.ejs") %>
        </main>
      </div>
    </div>
    <script src="/scripts/spinner.js"></script>
  </body>
</html>
