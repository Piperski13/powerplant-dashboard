<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- account, menu icons -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=account_circle,menu,search,filter_list,edit,delete,description,add"
    />

    <link rel="icon" href="/assets/icons/favicon.png" type="image/svg+xml" />

    <!-- Local Styles -->
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/table.css" />
    <link rel="stylesheet" href="/styles/documents.css" />

    <title>Collection details</title>
  </head>

  <body>
    <div class="app-shell">
      <aside class="app-sidebar">
        <%- include("../partials/sidebar.ejs") %>
      </aside>

      <div class="app-main">
        <main class="app-content records-view-page">
          <nav class="breadcrumbs">
            <a href="/workspaces/"> Workspaces </a>

            <span>/</span>

            <a href="/workspaces/<%= workspace.id %>">
              <%= workspace.name %>
            </a>

            <span>/</span>

            <span> <%= collection.name %> </span>
          </nav>
          <%- include("../partials/_entity-details", {
            entityType: "Collection",
            entityName: collection.name,
            entityDescription: collection.description,
            createdAt: collection.created_at,
            updatedAt: collection.updated_at
          }) %>
          
          <%- include("../partials/_filter-toolbar", { searchRoute:
          `/workspaces/${workspace.id}/collections/${collection.id}`,
          searchParam: "title", searchPlaceholder: "Search records...",
          searchValue: title, createRoute:
          `/workspaces/${workspace.id}/collections/${collection.id}/records/new`,
          createLabel: "New Record", ownerId: workspace.owner_id, user: user,
          visibility: workspace.visibility, usersListPage:false }) %>

          <div class="div-tables-section">
            <table id="big-table">
              <caption>
                List of Records
              </caption>
              <thead>
                <tr>
                  <th>Title</th>
                  <th>Description</th>
                  <th>Documents</th>

                  <% if (user && user.id === workspace.owner_id) { %>
                  <th class="table-actions-header">Actions</th>
                  <% } %>
                </tr>
              </thead>
              <tbody>
                <% if (records && records.length > 0) { %> <%
                records.forEach(record => { %>
                <tr
                  class="clickable-row"
                  data-href="/workspaces/<%= workspace.id %>/collections/<%= collection.id %>/records/<%= record.id %>"
                >
                  <td data-label="Title">
                    <div class="table-primary">
                      <%= record.title %></td>
                    </div>
                    
                  <td data-label="Description"><%= record.description %></td>

                  <td data-label="Documents">
                  <% if (record.files && record.files.length > 0) { %>
                    <div class="documents-list">
                      <% record.files.forEach(file => { %>
                        <a
                          class="file-link"
                          href="<%= file.downloadUrl %>"
                          download
                          title="<%= file.original_name %>"
                        >
                          <span class="material-symbols-outlined">description</span>
                          <span class="file-link__name">
                            <%= file.original_name.length > 20
                              ? file.original_name.slice(0, 20) + "..."
                              : file.original_name %>
                          </span>
                        </a>
                      <% }) %>
                    </div>
                    <% } else { %>
                      <span class="documents-empty">No files</span>
                    <% } %>
                  </td>
                  <% if (user && user.id === workspace.owner_id) { %>
                  <td data-label="Actions" class="table-actions">
                    <div class="table-actions__group">
                      <form
                        action="/workspaces/<%= workspace.id %>/collections/<%= collection.id %>/records/<%= record.id %>/edit"
                        method="GET"
                      >
                        <button
                          type="submit"
                          class="table-action table-action--edit"
                        >
                          <span class="material-symbols-outlined">edit</span>
                          Edit
                        </button>
                      </form>

                      <form
                        action="/workspaces/<%= workspace.id %>/collections/<%= collection.id %>/records/<%= record.id %>/delete"
                        method="POST"
                      >
                        <button
                          type="submit"
                          class="table-action table-action--delete"
                        >
                          <span class="material-symbols-outlined">delete</span>
                          Delete
                        </button>
                      </form>
                    </div>
                  </td>
                  <% } %>
                </tr>
                <% }) %> <% } else { %>
                <tr>
                  <td colspan="5">No collections found.</td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <div class="back-navigation">
            <a
              href="/workspaces/<%= workspace.id %>"
              class="button button--secondary"
            >
              ← Back to Workspace
            </a>
          </div>
          <%- include("../partials/spinner.ejs") %>
        </main>
      </div>
    </div>
    <script src="/scripts/table-row-navigation.js"></script>
  </body>
</html>
