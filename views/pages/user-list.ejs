<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- account, menu icons -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=account_circle,menu,search,filter_list,edit,delete"
    />

    <link rel="icon" href="/assets/icons/favicon.png" type="image/svg+xml" />

    <!-- Local Styles -->
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/table.css" />

    <title>CRUD</title>
  </head>

  <body>
    <div class="app-shell">
      <aside class="app-sidebar">
        <%- include("../partials/sidebar.ejs") %>
      </aside>

      <div class="app-main">
        <main class="app-content users-page">
          <div class="div-tables-section">
            <%- include("../partials/_filter-toolbar", { searchRoute:
            `/users/`, searchParam: "email",
            searchPlaceholder: "Search by Email...", searchValue: email,
            createRoute: ``,
            createLabel: "", ownerId: user ? user.id : null , user:
            user, visibility:null  }) %>

            <div class="div-tables-section">
              <table id="big-table">
                <caption>
                List of Users
                </caption>
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Email</th>
                    <th>Firstname</th>
                    <th>Lastname</th>
                    <th>Admin Status</th>
                    <th class="table-actions-header">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (profiles && profiles.length > 0) { %> <%
                  profiles.forEach(user => { %>
                  <tr>
                    <td><%= user.id %></td>
                    <td>
                      <div class="table-primary">
                        <%= user.email %>
                      </div>
                    </td>
                    <td><%= user.first_name %></td>
                    <td><%= user.last_name %></td>
                    <td>
                      <div class="table-primary">
                      <%= user.is_admin %>
                      </div>
                    </td>
                    <td data-label="Actions" class="table-actions">
                      <div class="table-actions__group">
                        <form
                          action="/users/<%= user.id %>/edit"
                          method="GET"
                        >
                          <button
                            type="submit"
                            class="table-action table-action--edit"
                          >
                            <span class="material-symbols-outlined">edit</span>
                            Edit
                          </button>
                        </form>

                        <form
                          action="/users/<%= user.id %>/delete"
                          method="POST"
                        >
                          <button
                            type="submit"
                            class="table-action table-action--delete"
                          >
                            <span class="material-symbols-outlined">delete</span>
                            Delete
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                  <% }) %> <% } else { %>
                  <tr>
                    <td colspan="8">No records found.</td>
                  </tr>
                  <% } %>
                </tbody>
              </div>
            </table>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>
